# ── Upstash Redis (콘솔 > Redis > 내 DB > REST API) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── 로컬 개발: true면 SDK가 로컬 QStash 서버를 자동 실행 (토큰 불필요) ──
QSTASH_DEV=true

# ── 배포(Vercel)용 QStash 값 (콘솔 > QStash). 배포 시 QSTASH_DEV는 넣지 마세요 ──
# QSTASH_URL=
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=

# (선택) 워커 호출 주소를 고정하고 싶을 때. 비우면 요청 주소를 사용
# APP_URL=https://your-app.vercel.app
